<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Deep links: resilnet://board/invite?... and resilnet://peer/invite?... -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.ajarnnarin.resilnet.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>resilnet</string>
			</array>
		</dict>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>ResilNet uses Bluetooth to find nearby peers and ESP32 mesh gateways. If Bluetooth is unavailable, internet (Nostr) messaging still works.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>ResilNet may advertise so nearby devices can discover this Mac on the mesh.</string>
	<key>NSCameraUsageDescription</key>
	<string>ResilNet uses the camera to scan identity and board-invite QR codes.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>ResilNet uses the microphone for sealed voice notes.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ResilNet uses location for Area geohash presence over Nostr (optional on Mac).</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ResilNet saves invite QR images to your photo library when you choose Save.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>ResilNet saves invite QR images to your photo library when you choose Save.</string>
</dict>
</plist>
