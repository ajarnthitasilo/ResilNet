# ResilNet lab node A — TCP server on localhost:4242
# Isolated shared-instance ports so two rnsd can coexist on one Mac.

[reticulum]
  enable_transport = Yes
  share_instance = Yes
  instance_name = resilnet-lab-a
  shared_instance_port = 37428
  instance_control_port = 37429

[logging]
  loglevel = 7

[interfaces]

  [[Lab TCP Server]]
    type = TCPServerInterface
    enabled = yes
    listen_ip = 127.0.0.1
    listen_port = 4242
